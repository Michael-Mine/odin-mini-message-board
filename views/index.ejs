<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
  </head>
  <body>
    <h1><%= title %></h1>
    <a href="/new">Add New Message</a>
    <ol>
      <% messages.forEach((message) => { %>
        <li>
          <span><%= message.name %></span>
          <span>-</span>
          <span><%= message.added %></span>
          <p><%= message.text %></p>
          <a href="/message/<%= message.id %>" target="_blank">Open</a>
        </li>
        <br>
      <% }); %>
    </ol>
  </body>
</html>
